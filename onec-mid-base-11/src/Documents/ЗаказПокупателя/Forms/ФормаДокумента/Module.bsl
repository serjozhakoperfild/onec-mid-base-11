#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура РассчитатьСуммуСтроки(ТекущиеДанные)
	
	//Доработано 09.09.2026, ДЗ_Командная работа (EDT)
	//Производит расчет скидки суммированием рекизита Расш1_СогласованнаяСкидка и поля Скидка из табличной части документа,
	//исключая получение отрицательного значения в столбце Сумма табличной части документа.
	КоэффициентСкидки = 1 - (Объект.ДЗ_СогласованнаяСкидка + ТекущиеДанные.Скидка) / 100;

	Если КоэффициентСкидки < 0 Тогда
		ПредупреждениеАсинх("Сумма скидки превышает 100%.", 3, "Внимание!");
		КоэффициентСкидки = 0;
	КонецЕсли;

	ТекущиеДанные.Сумма = ТекущиеДанные.Цена * ТекущиеДанные.Количество * КоэффициентСкидки;

КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммуДокумента()

	Объект.СуммаДокумента = Объект.Товары.Итог("Сумма") + Объект.Услуги.Итог("Сумма");

КонецПроцедуры

//Доработано 09.09.2026, ДЗ_Командная работа (EDT)
&НаКлиенте
Процедура ДЗ_ПересчитатьТовары()
	//Пересчитать значения в столбце "Сумма" табличной части "Товары"
	Для Каждого Строка Из Объект.Товары Цикл
		РассчитатьСуммуСтроки(Строка);
		РассчитатьСуммуДокумента();
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ДЗ_ПересчитатьУслуги()
	//Пересчитать значения в столбце "Сумма" табличной части "Услуги"
	Для Каждого Строка Из Объект.Услуги Цикл
		РассчитатьСуммуСтроки(Строка);
		РассчитатьСуммуДокумента();
	КонецЦикла;

КонецПроцедуры
//))Конец Доработано 09.09.2026

