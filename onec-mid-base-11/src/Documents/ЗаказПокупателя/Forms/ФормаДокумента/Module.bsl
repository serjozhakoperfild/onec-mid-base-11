&НаКлиенте
Асинх Процедура ДЗ_СогласованнаяСкидкаПриИзменении(Элемент)
	//Вызов диалогового окна при изменении значения "Согласованная скидка"
	Если Объект.Товары.Количество() > 0 Или Объект.Услуги.Количество() > 0 Тогда
		Ответ = Ждать ВопросАсинх("Изменен процент скидки. Пересчитать таблицу товаров и услуг?", РежимДиалогаВопрос.ДаНет);

		Если Ответ = КодВозвратаДиалога.Да Тогда
			ДЗ_ПересчитатьТовары();
			ДЗ_ПересчитатьУслуги();
		КонецЕсли;

	КонецЕсли;

КонецПроцедуры
//))Конец Доработано 09.09.2026

